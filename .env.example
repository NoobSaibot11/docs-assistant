# Copy to .env and fill in the API keys.
# Local dev (pnpm dev) talks to the compose `db` service on localhost.
# Inside docker compose, the app overrides DATABASE_URL to use the `db` host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_assistant
# Host port for the compose db. If a local Postgres already uses 5432, set e.g. 5433
# here and use the same port in DATABASE_URL above.
DB_PORT=5432
# Host port for the app container (http://localhost:3000).
APP_PORT=3000
# Integration tests use their own database (created automatically; the name must contain "test").
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_assistant_test

# Only needed for ingestion, chat and eval; the app starts without them.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Optional: raises GitHub's API limit (60/hour) for listing docs files during ingestion.
GITHUB_TOKEN=

CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5   # query rewrite + framework tagging
ANSWER_EFFORT=low                    # answer thinking effort: low | medium | high | xhigh | max
CLAUDE_JUDGE_MODEL=claude-opus-5-5     # eval only: grades answer faithfulness
VOYAGE_MODEL=voyage-4                # 1024-dim; must match vector(1024) in the schema
RERANK_MODEL=rerank-3                # Voyage reranker over the top 20 ("none" = off)
# Without a payment method on your Voyage account, its limits are 3 requests and 10K tokens per
# minute: set VOYAGE_RPM=3 and VOYAGE_TPM=10000 (Next.js + Jest then take ~100 min). Leave empty otherwise.
VOYAGE_RPM=
VOYAGE_TPM=

INGEST_FRAMEWORKS=all                # or a comma list, e.g. nextjs,jest
RETRIEVAL_MODE=vector                # vector | keyword | hybrid (vector scored best in the eval)
HYBRID_KEYWORD_WEIGHT=0.1            # keyword weight in hybrid fusion (vector = 1); tuned by the eval
NOT_FOUND_THRESHOLD=0.4              # tuned with the eval sweep (pre-filter before the answer call)
