# Copy to .env and fill in the API keys.
# Local dev (pnpm dev) talks to the compose `db` service on localhost.
# Inside docker compose, the app overrides DATABASE_URL to use the `db` host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_assistant
# Host port for the compose db. If a local Postgres already uses 5432, set e.g. 5433
# here and use the same port in DATABASE_URL above.
DB_PORT=5432
# Host port for the app container (http://localhost:3000).
APP_PORT=3000

# Only needed for ingestion, chat and eval; the app starts without them.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5   # query rewrite + framework tagging
VOYAGE_MODEL=voyage-4                # 1024-dim; must match vector(1024) in the schema

INGEST_FRAMEWORKS=all                # or a comma list, e.g. nextjs,jest
RETRIEVAL_MODE=hybrid                # vector | keyword | hybrid
NOT_FOUND_THRESHOLD=0.35             # tune using the eval set
